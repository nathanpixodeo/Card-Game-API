# Copy to .env and fill in. Never commit .env — it is gitignored.

# MongoDB connection string. Required.
DB_URL=mongodb://<user>:<password>@localhost:27017/multigaming

# HTTP port.
# NOTE: currently ignored. index.js reads process.env.PORT before dotenv.config()
# runs, so this value never arrives. The server listens on 8797 regardless.
PORT=8797

# JWT signing keys. Set both to long random strings, and make them different
# from each other. If unset, the code falls back to a constant that is public
# in this repository, which lets anyone forge a token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Token lifetimes, as ms duration strings. Defaults: 1h and 3650d.
ACCESS_TOKEN_LIFE=1h
REFRESH_TOKEN_LIFE=30d
